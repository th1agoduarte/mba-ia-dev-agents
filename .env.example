# Copie para `.env` na raiz do repositório: cp .env.example .env

# --------------------------------------------------------------------------- #
# Obrigatório                                                                  #
# --------------------------------------------------------------------------- #

# Escolhe o provider de modelo de TODOS os agentes: gemini (padrão) | anthropic.
# gemini  -> precisa de GOOGLE_API_KEY
# anthropic -> precisa de ANTHROPIC_API_KEY
# OBS: o MODELO de cada agente é escolhido por variável própria mais abaixo
# (seção "Modelo por agente"); vazio usa DEFAULT_MODEL (sem custo).
MODEL_PROVIDER=gemini

# Chave do Gemini (https://aistudio.google.com/apikey). Usada quando
# MODEL_PROVIDER=gemini. Lida pelo ADK e pelo langchain-google-genai.
GOOGLE_API_KEY=

# Chave da Anthropic (https://console.anthropic.com/settings/keys). Usada quando
# MODEL_PROVIDER=anthropic. Lida pelo litellm (agents/) e, nos exemplos LangChain,
# pelo langchain-anthropic (uv add langchain-anthropic).
ANTHROPIC_API_KEY=

# Servidor MCP da conta (outside/account_mcp_server.py). NÃO têm default: sem
# estas duas, importar `agents/ticket_resolution` quebra na hora do import.
ACCOUNT_MCP_HOST=127.0.0.1
ACCOUNT_MCP_PORT=8765

# --------------------------------------------------------------------------- #
# Política de estorno — os limiares que decidem o caminho do ticket_resolution  #
# --------------------------------------------------------------------------- #

# Acima deste valor, o estorno PAUSA pedindo aprovação humana.
REFUND_APPROVAL_THRESHOLD=50

# Acima deste valor, nem se pede aprovação: vira handoff humano direto.
REFUND_MAX_LIMIT=200

# --------------------------------------------------------------------------- #
# Opcional                                                                     #
# --------------------------------------------------------------------------- #

# Onde `web.py` guarda as sessões: sqlite (default) | memoria | postgres.
# A aprovação do estorno chega em OUTRA requisição, então só os persistentes
# seguram a pausa se o servidor cair no meio.
SESSION_BACKEND=sqlite
SESSION_DB_URL=postgresql+asyncpg://acme:acme@localhost:5432/acme

# Banco dos tickets. Default: SQLite em agents/tickets.db.
# DATABASE_URL=postgresql+asyncpg://acme:acme@localhost:5432/acme

# MCP do Linear (usado pelo `escalator` e pelo ex_11_mcp). Sem a chave, o
# escalonador grava só o card local — o resto do fluxo continua funcionando.
LINEAR_MCP_URL=https://mcp.linear.app/mcp
LINEAR_API_KEY=

# --------------------------------------------------------------------------- #
# Modelo por agente                                                            #
# --------------------------------------------------------------------------- #

# Valor padrão (SEM CUSTO): usado por qualquer agente cuja variável abaixo
# esteja vazia. Com MODEL_PROVIDER=anthropic, o nome Gemini vira o Claude
# equivalente automaticamente.
DEFAULT_MODEL=gemini-3.5-flash-lite

# Modelo de cada agente (vazio = usa DEFAULT_MODEL). O nome da variável é o
# nome da pasta do agente em MAIÚSCULAS + _MODEL.
# Opções Gemini: gemini-3.5-flash-lite | gemini-3.5-flash | gemini-3.1-flash-lite
MEU_AGENTE1_MODEL=
MEU_AGENTE2_MODEL=
OPERADOR_CONTA_MODEL=
OPERADOR_CONTA_AGENTTOOL_MODEL=
OPERADOR_CONTA_SESSION_MODEL=
OPERADOR_CONTA_SESSION_STATE_MODEL=
OPERADOR_CONTA_SINGLE_TURN_MODEL=
OPERADOR_CONTA_SUBAGENT_MODEL=
OPERADOR_CONTA_TASK_MODEL=
TICKET_RECEPTIONIST_MODEL=
TICKET_CLASSIFIER_MODEL=
ACCOUNT_OPERATOR_MODEL=
ATTENDANT_MODEL=
ESCALATOR_MODEL=
REFUND_INVESTIGATOR_MODEL=
